# syntax=docker/dockerfile:1
#
# 从源码构建的运行镜像（替代官方 Dockerfile 的 "COPY 预编译二进制" 做法）。
#
# 官方 Dockerfile 的关键风险点在于：
#     COPY dist/${TARGETARCH}/artex /app/artex
# 即镜像里的可执行文件是**外部提供**的，源码仓库无法证明它的来源——
# 已确认 tomicdd/artex:latest 就是这样被塞进了一个未公开的登录后门。
# 本文件把「编译」搬进镜像，产物只可能来自当前构建上下文里的源码。
#
# 构建：
#   docker build -f Dockerfile.fromsource -t catty:patched .
# 注意：go.mod 要求 go 1.26.3，请确保 golang 镜像 tag 与之匹配。

# ---------- 1) 前端静态产物 ----------
FROM node:20-bookworm-slim AS web
WORKDIR /src/web
COPY web/package.json web/package-lock.json* ./
RUN npm ci
COPY web/ ./
RUN npm run build:static

# ---------- 2) 后端二进制（内嵌前端）----------
FROM golang:1.26-alpine AS build
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# 把第 1 阶段产出的静态资源放进内嵌目录，供 -tags embedui 打包进去
COPY --from=web /src/web/out /src/server/webui/dist
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} \
    go build -tags embedui -trimpath -o /out/catty ./cmd/catty

# ---------- 3) 运行镜像 ----------
FROM python:3.12-slim-bookworm
ARG TARGETARCH

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates ripgrep curl wget vim git jq unzip \
      dnsutils iputils-ping netcat-openbsd inetutils-telnet whois nmap \
    && rm -rf /var/lib/apt/lists/*

# 可选：浏览器自动化（browser MCP / playwright-cli 需要）。
# 官方镜像会装，体积约 450 MB；不需要就保持注释。
# RUN apt-get update && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
#     && apt-get install -y --no-install-recommends nodejs \
#     && npm install -g @playwright/mcp@1 @playwright/cli@1 playwright@1 \
#     && playwright install --with-deps chromium \
#     && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=build /out/catty /app/catty
COPY start.sh /app/start.sh
COPY skills/ /app/skills/
RUN chmod +x /app/catty /app/start.sh

VOLUME ["/app/data"]
EXPOSE 8787 8788
ENTRYPOINT ["/app/start.sh"]
CMD ["-addr", ":8787", "-proxy", ":8788"]
